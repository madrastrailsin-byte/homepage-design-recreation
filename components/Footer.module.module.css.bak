/* Homepage footer — Mediterranean light edition. All rules are scoped here. */
.footer {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: #f7efe6;
  color: #12383b;
}

.scenery {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image: url('/images/homepage/footer-mediterranean.webp');
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
}

.footer::before {
  content: '';
  position: absolute;
  inset: 0 0 auto;
  height: 116px;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(
    to bottom,
    var(--mt-canvas) 0%,
    rgba(3, 25, 29, .88) 18%,
    transparent 100%
  );
}

.footer::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(180deg, transparent 0%, rgba(247,239,230,.05) 34%, rgba(247,239,230,.12) 68%, rgba(247,239,230,.50) 100%);
}

.gradientDefinitions { position: absolute; width: 0; height: 0; overflow: hidden; }

.inner {
  position: relative;
  width: min(90%, 1740px);
  margin: 0 auto;
  padding: clamp(125px, 10vw, 155px) 0 24px;
}

.columns {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(270px, 320px);
  align-items: start;
  gap: clamp(36px, 4vw, 76px);
  padding-inline: clamp(50px, 5vw, 110px) clamp(85px, 8vw, 170px);
}



.brandMark :global(img) { max-width: 100%; height: auto; }


.callback {
  min-width: 0;
  max-width: 660px;
}
.eyebrow {
  margin: 0 0 6px;
  color: #a77936;
  font-family: var(--mt-font-ui), sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .22em;
}
.heading {
  margin: 0;
  color: #12383b;
  font-family: var(--mt-font-display), Georgia, serif;
  font-size: clamp(30px, 2.4vw, 39px);
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -.022em;
}
.description {
  max-width: 600px;
  margin: 8px 0 10px;
  color: #24474a;
  font-family: var(--mt-font-body), sans-serif;
  font-size: clamp(12px, .95vw, 14px);
  line-height: 1.55;
}
.form {
  width: min(100%, 620px);
}
.phoneField {
  display: flex;
  align-items: stretch;
  min-height: 52px;
  overflow: hidden;
  border: 1px solid #bd985b;
  border-radius: 13px;
  background: rgba(255, 252, 247, .91);
  box-shadow: 0 12px 35px rgba(50, 42, 31, .09);
  transition: border-color .25s, box-shadow .25s;
}
.phoneField:focus-within { border-color: #8e6427; box-shadow: 0 0 0 3px rgba(183, 136, 60, .15); }
.countryCode {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 0 18px;
  border-right: 1px solid #ddccb5;
  color: #aa7c37;
  font-size: 17px;
  font-weight: 700;
}
.phoneInput {
  width: 100%;
  min-width: 0;
  flex: 1;
  padding: 0 17px;
  border: 0;
  outline: 0;
  background: transparent;
  color: #12383b;
  font-family: var(--mt-font-body), sans-serif;
  font-size: 16px;
}
.phoneInput::placeholder { color: #78817c; opacity: 1; }
.submit {
  display: grid;
  place-items: center;
  width: 54px;
  flex-shrink: 0;
  border: 0;
  background: #b88b42;
  color: #fff;
  cursor: pointer;
  transition: background .25s;
}
.submit:hover { background: #936923; }
.submit:disabled { cursor: wait; opacity: .65; }
.feedback { min-height: 24px; padding-top: 6px; color: #8c4a2e; font-size: 12px; }
.feedback p { margin: 0; }
.success { display: flex; align-items: center; gap: 6px; color: #1f694d; }

.social {
  position: relative;
  top: clamp(38px, 3vw, 56px);
  min-width: 0;
  justify-self: center;
  align-self: start;
  text-align: center;
}
.socialTitle {
  margin: 0 0 12px;
  color: #16383c;
  font-family: var(--mt-font-ui), sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .24em;
}
.socialLinks { display: flex; flex-wrap: wrap; justify-content: center; gap: 13px; }
.socialLink {
  display: grid;
  place-items: center;
  width: 50px;
  height: 50px;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, .91);
  box-shadow: 0 8px 24px rgba(43, 48, 47, .11), inset 0 1px 0 rgba(255,255,255,.95);
  transition: transform .25s, box-shadow .25s;
}
.socialLink:hover { transform: translateY(-3px); box-shadow: 0 13px 28px rgba(43,48,47,.17); }
.socialLink:focus-visible { outline: 3px solid #b88b42; outline-offset: 3px; }
.socialLink svg { width: 23px; height: 23px; }
.instagram svg { fill: url('#mt-footer-instagram-gradient'); }
.facebook svg { fill: #1877f2; }
.youtube svg { fill: #ff0033; width: 25px; height: 25px; }
.whatsapp svg { fill: #25d366; width: 26px; height: 26px; }

.bottom {
  display: grid;
  gap: 17px;
  margin-top: 36px;
  color: #365659;
  font-family: var(--mt-font-body), sans-serif;
  font-size: 13.5px;
}
.contactLinks {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.35fr) minmax(0, 1.15fr);
  align-items: center;
  gap: 12px 22px;
}
.contactLink {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  color: inherit;
  text-decoration: none;
  white-space: normal;
  transition: color .2s;
}
.contactLink:hover { color: #12383b; }
.contactLink svg { flex-shrink: 0; color: #b28a47; }
.copyright {
  margin: 0;
  white-space: nowrap;
}

@media (max-width: 1199px) {
  .inner { width: min(92%, 1100px); }
  .columns { gap: 28px; padding-inline: 0; }
  .social { top: 0; }
  .contactLinks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .heading { font-size: clamp(32px, 3.6vw, 44px); }
  .socialLinks { gap: 10px; }
}

@media (max-width: 767px) {
  .inner { padding: 100px 24px 24px; }
  .heading { font-size: clamp(32px, 8vw, 43px); }
  .description { font-size: 14px; }
  .bottom { margin-top: 28px; font-size: 12px; }
  .contactLinks { grid-template-columns: 1fr; gap: 14px 22px; }
  .contactLink { white-space: normal; }
  .legal { align-items: flex-start; flex-direction: column; }
  .copyright { white-space: normal; }
  .scenery { background-size: auto 470px; background-position: 55% top; }
}

@media (prefers-reduced-motion: reduce) {
  .socialLink, .phoneField, .submit { transition: none; }
}


/* Footer legal links — reserved until policy pages are connected */
.legal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px 30px;
}
.policyLinks {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px 28px;
  color: #264b4e;
  font-size: 13.5px;
  font-weight: 600;
}

@media (max-width: 899px) {
  .inner { width: 100%; padding-left: 24px; padding-right: 24px; }
  .columns { grid-template-columns: 1fr; gap: 25px; }
  .social {
    top: 0;
    justify-self: start;
    text-align: left;
  }
  .socialLinks { justify-content: flex-start; }
  .contactLinks { justify-content: flex-start; }
  .legal { flex-wrap: wrap; }
}
