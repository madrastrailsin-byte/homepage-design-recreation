'use client'

import { FormEvent, useEffect, useState } from 'react'
import { motion, useReducedMotion } from 'framer-motion'
import { ArrowRight, Check, Globe2, Mail, MapPin, Phone } from 'lucide-react'
import { FaFacebookF, FaInstagram, FaWhatsapp, FaYoutube } from 'react-icons/fa'
import { submitEnquiry } from '@/lib/enquiries'
import styles from './Footer.module.css'

export default function Footer() {
  const [phone, setPhone] = useState('')
  const [submitted, setSubmitted] = useState(false)
  const [showError, setShowError] = useState(false)
  const [isSubmitting, setIsSubmitting] = useState(false)
  const [submitError, setSubmitError] = useState('')
  const prefersReducedMotion = useReducedMotion()

  useEffect(() => {
    if (!submitted) return
    const timer = window.setTimeout(() => {
      setSubmitted(false)
      setPhone('')
    }, 3500)
    return () => window.clearTimeout(timer)
  }, [submitted])

  const motionEase = [0.22, 1, 0.36, 1] as const
  const revealInitial = prefersReducedMotion ? { opacity: 1 } : { opacity: 0, y: 14 }
  const revealInView = { opacity: 1, y: 0 }

  async function handleCallbackRequest(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    if (!/^\d{10}$/.test(phone)) {
      setShowError(true)
      setSubmitted(false)
      return
    }
    setShowError(false)
    setSubmitError('')
    setIsSubmitting(true)
    try {
      await submitEnquiry({ type: 'callback', phone: `+91${phone}` })
      setSubmitted(true)
    } catch (error) {
      setSubmitError(error instanceof Error ? error.message : 'We could not send your request. Please try again.')
    } finally {
      setIsSubmitting(false)
    }
  }

  return (
    <footer className={styles.footer}>
      <div className={styles.scenery} aria-hidden="true" />

      {/* Instagram's multicolour identity is rendered as a vector gradient. */}
      <svg className={styles.gradientDefinitions} aria-hidden="true" focusable="false" width="0" height="0">
        <defs>
          <linearGradient id="mt-footer-instagram-gradient" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0%" stopColor="#FEDA75" />
            <stop offset="28%" stopColor="#FA7E1E" />
            <stop offset="52%" stopColor="#D62976" />
            <stop offset="78%" stopColor="#962FBF" />
            <stop offset="100%" stopColor="#4F5BD5" />
          </linearGradient>
        </defs>
      </svg>

      <div className={styles.inner}>
        <div className={styles.columns}>


          <motion.div
            className={styles.callback}
            initial={revealInitial}
            whileInView={revealInView}
            viewport={{ once: true, amount: 0.2 }}
            transition={{ duration: 0.7, delay: 0.08, ease: motionEase }}
          >
            <p className={styles.eyebrow}>LET&apos;S PLAN SOMETHING BEAUTIFUL</p>
            <h2 className={styles.heading}>Not ready to plan? Let&apos;s talk.</h2>
            <p className={styles.description}>
              Share your number and one of our travel designers will call you to discuss future ideas.
            </p>

            <form id="callback-request" className={styles.form} onSubmit={handleCallbackRequest} aria-busy={isSubmitting}>
              <div className={styles.phoneField}>
                <span className={styles.countryCode}>+91</span>
                <input
                  type="tel"
                  inputMode="numeric"
                  autoComplete="tel-national"
                  value={phone}
                  onChange={(event) => {
                    setPhone(event.target.value.replace(/\D/g, '').slice(0, 10))
                    setShowError(false)
                    setSubmitted(false)
                    setSubmitError('')
                  }}
                  placeholder="Enter mobile number"
                  aria-label="Mobile number"
                  className={styles.phoneInput}
                />
                <button type="submit" disabled={isSubmitting} aria-label="Request a callback" className={styles.submit}>
                  <ArrowRight size={22} aria-hidden="true" />
                </button>
              </div>
              <div className={styles.feedback} aria-live="polite">
                {submitted && <p className={styles.success}><Check size={15} aria-hidden="true" /> Request received. We&apos;ll contact you shortly.</p>}
                {showError && <p role="alert">Please enter a valid 10-digit mobile number.</p>}
                {submitError && <p role="alert">{submitError}</p>}
              </div>
            </form>
          </motion.div>

          <motion.div
            className={styles.social}
            initial={revealInitial}
            whileInView={revealInView}
            viewport={{ once: true, amount: 0.2 }}
            transition={{ duration: 0.7, delay: 0.16, ease: motionEase }}
          >
            <h3 className={styles.socialTitle}>FOLLOW US</h3>
            <div className={styles.socialLinks}>
              <a href="https://www.instagram.com/madrastrails/" target="_blank" rel="noopener noreferrer" aria-label="MadrasTrails on Instagram" className={`${styles.socialLink} ${styles.instagram}`}>
                <FaInstagram aria-hidden="true" />
              </a>
              <a href="https://www.facebook.com/MadrasTrails/" target="_blank" rel="noopener noreferrer" aria-label="MadrasTrails on Facebook" className={`${styles.socialLink} ${styles.facebook}`}>
                <FaFacebookF aria-hidden="true" />
              </a>
              <a href="https://www.youtube.com/@madrastrails" target="_blank" rel="noopener noreferrer" aria-label="MadrasTrails on YouTube" className={`${styles.socialLink} ${styles.youtube}`}>
                <FaYoutube aria-hidden="true" />
              </a>
              <a href="https://wa.me/917891876918" target="_blank" rel="noopener noreferrer" aria-label="Chat with MadrasTrails on WhatsApp" className={`${styles.socialLink} ${styles.whatsapp}`}>
                <FaWhatsapp aria-hidden="true" />
              </a>
            </div>
          </motion.div>
        </div>

        <div className={styles.bottom}>
          <div className={styles.contactLinks}>
            <a href="https://www.google.com/maps/search/?api=1&query=%23362%2C%20Eden%20Avenue%2C%20Mogappair%2C%20Chennai%20%E2%80%93%20600%20037" target="_blank" rel="noopener noreferrer" className={styles.contactLink}>
              <MapPin size={17} aria-hidden="true" />
              <span>#362, Eden Avenue, Mogappair, Chennai – 600 037</span>
            </a>
            <a href="tel:+917891876918" className={styles.contactLink}>
              <Phone size={16} aria-hidden="true" />
              <span>+91 78918 76918</span>
            </a>
            <a href="mailto:info@madrastrails.in" className={styles.contactLink}>
              <Mail size={17} aria-hidden="true" />
              <span>info@madrastrails.in</span>
            </a>
            <a href="https://www.madrastrails.in" target="_blank" rel="noopener noreferrer" className={styles.contactLink}>
              <Globe2 size={17} aria-hidden="true" />
              <span>www.madrastrails.in</span>
            </a>
          </div>
          <div className={styles.legal}>
            <div className={styles.policyLinks} aria-label="Website policies">
              <span>Terms &amp; Conditions</span>
              <span>Privacy Policy</span>
              <span>Cancellation &amp; Refund Policy</span>
            </div>
            <p className={styles.copyright}>
              © {new Date().getFullYear()} MadrasTrails. All Rights Reserved.
            </p>
          </div>
        </div>
      </div>
    </footer>
  )
}
